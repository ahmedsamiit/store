<section class="login-page">
    <div class="login-card">
        <a class="login-logo" href="/">store<span>.prime</span></a>
        <p class="eyebrow">Welcome Back</p>
        <h1>Sign in to your account</h1>
        <p class="login-copy">Use your email and password to access your dashboard or continue shopping.</p>

        {{#if error}}
            <div class="login-error">{{error}}</div>
        {{/if}}

        <form action="/auth/login" method="POST" class="login-form">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <label for="email">Email</label>
            <input id="email" class="{{#if errors.email}}is-invalid{{/if}}" type="email" name="email" placeholder="admin@example.com" value="{{email}}" required>
            {{#if errors.email}}
                <span class="field-error">{{errors.email}}</span>
            {{/if}}

            <label for="password">Password</label>
            <input id="password" class="{{#if errors.password}}is-invalid{{/if}}" type="password" name="password" placeholder="Enter password" required>
            {{#if errors.password}}
                <span class="field-error">{{errors.password}}</span>
            {{/if}}

            <button type="submit">Login</button>
        </form>

        <p class="login-note">Don't have an account? <a href="/auth/register">Register</a></p>
    </div>
</section>
